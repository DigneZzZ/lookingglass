{$LG_DOMAIN} {
    encode gzip

    # Reject private paths before PHP rewrites or static file serving.
    @private path_regexp private (?i)(^|/)[.]|^/+(docker|tests)(/|$)|^/+(docker-compose[^/]*|config[.](dist[.])?php[^/]*)(/|$)
    handle @private {
        respond "Not found" 404
    }

    handle /download.php {
        reverse_proxy downloads:80 {
            header_up X-LG-Client {remote_host}
            flush_interval -1
        }
    }

    handle /_speedtest/* {
        respond 404
    }
    
    # Block direct access to speedtest files - must use download.php
    handle /files/* {
        respond "Access denied. Use the web interface to download test files." 403
    }
    
    # Main application
    handle {
        root * /var/www/html
        php_fastcgi lg-php:9000
        file_server
    }
    
    tls {$LG_EMAIL}
    

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}
